{
  "name": "cogwild",
  "productName": "Cogwild",
  "version": "0.6.0",
  "description": "Build any mech, then rule the land, water and sky.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "copy-game": "node copy-game.js",
    "start": "npm run copy-game && electron .",
    "build": "npm run copy-game && electron-builder --win"
  },
  "devDependencies": {
    "electron": "^31.7.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.cogwild.game",
    "productName": "Cogwild",
    "files": ["main.js", "app/**/*"],
    "directories": { "output": "dist" },
    "win": { "target": ["nsis", "portable"] }
  }
}
